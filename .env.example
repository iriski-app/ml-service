# This file contains no secrets. The service reads the process environment;
# it does not load .env automatically. Docker accepts --env-file .env.
MODEL_DIR=./models
ML_GRPC_LISTEN=127.0.0.1:50051
LLM_PROVIDER=yandex_configuration
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_PROMPT_ID=
YANDEX_PROMPT_VERSION=
LLM_TIMEOUT_SECONDS=20
LLM_RETRIES=1
